# Every TOML file except the tracked environment files and the configuration template,
# so that no configuration holding credentials can be committed
*.toml
!/Project.toml
!/test/Project.toml
!/format/Project.toml
!/config.example.toml
!/.JuliaFormatter.toml

# Coverage artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem

# Editor and OS artifacts
.DS_Store
.vscode/
.idea/
*.swp
*~
